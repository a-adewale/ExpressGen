{
  "name": "expressgen-generated-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
{% if project.database.provider == "postgresql" %}
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.16.0",
{% else %}
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "better-sqlite3": "^12.4.1",
{% endif %}
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
